{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maf.local/contracts/release-v1.schema.json",
  "title": "MAF release record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "project",
    "lane",
    "release_id",
    "source",
    "target",
    "execution",
    "status",
    "started_at",
    "updated_at",
    "gates",
    "artifacts",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "maf-release/v1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": [
        "underwriting-foundry-public",
        "order-resolution-azure-hosted",
        "order-resolution-foundry-public",
        "order-resolution-foundry-private"
      ]
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "profile",
        "profile_sha256",
        "environment",
        "subscription_id",
        "resource_group",
        "location"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "subscription_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "resource_group": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "executor"
      ],
      "properties": {
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "workflow_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "succeeded",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failed_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "skipped"
            ]
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(evidence|logs)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "durable_artifact": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "completed_at"
        ]
      }
    }
  ]
}
