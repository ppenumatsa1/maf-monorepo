# Copy this file to an ignored path, replace every placeholder, and pass it
# through FOUNDRY_DEPLOYMENT_PROFILE. Profiles contain target selectors and
# desired non-secret configuration only. Never add tenant IDs, user IDs,
# credentials, endpoints, generated resource IDs, or connection strings.
CONTRACT_VERSION=1
DEPLOYMENT_LANE=foundry-public
AZURE_ENV_NAME=replace-with-local-azd-environment
AZURE_SUBSCRIPTION_ID=replace-with-subscription-guid
AZURE_RESOURCE_GROUP=replace-with-resource-group
AZURE_LOCATION=replace-with-azure-region
INFRASTRUCTURE_MODE=reuse
FOUNDRY_LOCATION=replace-with-foundry-region
FOUNDRY_ACCOUNT_NAME=replace-with-foundry-account
FOUNDRY_PROJECT_NAME=replace-with-foundry-project
FOUNDRY_CUSTOM_SUBDOMAIN_NAME=replace-with-foundry-subdomain
HOSTED_AGENT_NAME=replace-with-hosted-agent
FOUNDRY_RUNTIME_CONNECTION_NAME=replace-with-runtime-connection
FOUNDRY_MODEL_DEPLOYMENT_NAME=replace-with-chat-deployment
FOUNDRY_MODEL_FORMAT=OpenAI
FOUNDRY_MODEL_NAME=replace-with-chat-model
FOUNDRY_MODEL_VERSION=replace-with-chat-version
FOUNDRY_MODEL_SKU_NAME=REPLACE
FOUNDRY_MODEL_CAPACITY=REPLACE
FOUNDRY_EMBEDDINGS_DEPLOYMENT_NAME=replace-with-embeddings-deployment
FOUNDRY_EMBEDDINGS_MODEL_FORMAT=OpenAI
FOUNDRY_EMBEDDINGS_MODEL_NAME=replace-with-embeddings-model
FOUNDRY_EMBEDDINGS_MODEL_VERSION=replace-with-embeddings-version
FOUNDRY_EMBEDDINGS_MODEL_SKU_NAME=REPLACE
FOUNDRY_EMBEDDINGS_MODEL_CAPACITY=REPLACE
FOUNDRY_EVAL_MODEL=replace-with-evaluator-deployment
FOUNDRY_EVALUATION_MODEL_FORMAT=OpenAI
FOUNDRY_EVALUATION_MODEL_NAME=replace-with-evaluator-model
FOUNDRY_EVALUATION_MODEL_VERSION=replace-with-evaluator-version
FOUNDRY_EVALUATION_MODEL_SKU_NAME=REPLACE
FOUNDRY_EVALUATION_MODEL_CAPACITY=REPLACE
FOUNDRY_RAI_POLICY_NAME=replace-with-rai-policy
AI_SEARCH_SERVICE_NAME=replace-with-search-service
AI_SEARCH_LOCATION=replace-with-search-region
AI_SEARCH_SKU_NAME=replace-with-search-sku
POSTGRES_SERVER_NAME=replace-with-postgres-server
POSTGRES_SERVER_LOCATION=replace-with-postgres-region
POSTGRES_SKU_NAME=replace-with-postgres-sku
POSTGRES_SKU_TIER=replace-with-postgres-tier
POSTGRES_VERSION=replace-with-postgres-version
POSTGRES_DATABASE=replace-with-database
POSTGRES_ADMIN_USERNAME=replace-with-admin-login
POSTGRES_RUNTIME_USERNAME=replace-with-runtime-login
CONTAINER_REGISTRY_NAME=replace-with-container-registry
CONTAINER_REGISTRY_SKU_NAME=REPLACE
CONTAINER_APPS_ENVIRONMENT_NAME=replace-with-container-apps-environment
BACKEND_CONTAINER_APP_NAME=replace-with-backend-app
FRONTEND_CONTAINER_APP_NAME=replace-with-frontend-app
PUBLIC_BACKEND_MANAGED_IDENTITY_NAME=replace-with-backend-identity
PUBLIC_FRONTEND_MANAGED_IDENTITY_NAME=replace-with-frontend-identity
APPLICATION_INSIGHTS_NAME=replace-with-app-insights
LOG_ANALYTICS_WORKSPACE_NAME=replace-with-log-analytics
BACKEND_IMAGE_REPOSITORY=replace-with-backend-repository
FRONTEND_IMAGE_REPOSITORY=replace-with-frontend-repository
HOSTED_AGENT_IMAGE_REPOSITORY=replace-with-hosted-repository
EVALUATION_STORAGE_ACCOUNT_NAME=replace-with-evaluation-storage
BOT_SERVICE_NAME=replace-with-bot-service
BOT_SERVICE_SKU_NAME=REPLACE
