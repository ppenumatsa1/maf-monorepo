{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "targetSubscriptionId": {
      "value": "${AZURE_SUBSCRIPTION_ID}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "infrastructureMode": {
      "value": "${INFRASTRUCTURE_MODE}"
    },
    "namePrefix": {
      "value": "${NAME_PREFIX}"
    },
    "postgresBootstrapAllowedIp": {
      "value": "${POSTGRES_BOOTSTRAP_ALLOWED_IP}"
    },
    "postgresDatabaseName": {
      "value": "${POSTGRES_DATABASE_NAME}"
    },
    "backendImage": {
      "value": "${BACKEND_IMAGE}"
    },
    "frontendImage": {
      "value": "${FRONTEND_IMAGE}"
    },
    "mcpServerUrl": {
      "value": "${MCP_SERVER_URL}"
    },
    "mcpApiKey": {
      "value": "${MCP_API_KEY}"
    },
    "mcpBearerToken": {
      "value": "${MCP_BEARER_TOKEN}"
    },
    "foundryProjectName": {
      "value": "${FOUNDRY_PROJECT_NAME}"
    },
    "foundryChatDeploymentName": {
      "value": "${FOUNDRY_CHAT_DEPLOYMENT_NAME}"
    },
    "foundryChatModelFormat": {
      "value": "${FOUNDRY_CHAT_MODEL_FORMAT}"
    },
    "foundryChatModelName": {
      "value": "${FOUNDRY_CHAT_MODEL_NAME}"
    },
    "foundryChatModelVersion": {
      "value": "${FOUNDRY_CHAT_MODEL_VERSION}"
    },
    "foundryChatDeploymentSkuName": {
      "value": "${FOUNDRY_CHAT_DEPLOYMENT_SKU_NAME}"
    },
    "foundryChatDeploymentCapacity": {
      "value": "${FOUNDRY_CHAT_DEPLOYMENT_CAPACITY}"
    },
    "foundryEmbeddingsDeploymentName": {
      "value": "${FOUNDRY_EMBEDDINGS_DEPLOYMENT_NAME}"
    },
    "foundryEmbeddingsModelFormat": {
      "value": "${FOUNDRY_EMBEDDINGS_MODEL_FORMAT}"
    },
    "foundryEmbeddingsModelName": {
      "value": "${FOUNDRY_EMBEDDINGS_MODEL_NAME}"
    },
    "foundryEmbeddingsModelVersion": {
      "value": "${FOUNDRY_EMBEDDINGS_MODEL_VERSION}"
    },
    "foundryEmbeddingsDeploymentSkuName": {
      "value": "${FOUNDRY_EMBEDDINGS_DEPLOYMENT_SKU_NAME}"
    },
    "foundryEmbeddingsDeploymentCapacity": {
      "value": "${FOUNDRY_EMBEDDINGS_DEPLOYMENT_CAPACITY}"
    },
    "foundryEvaluatorDeploymentCapacity": {
      "value": "${FOUNDRY_EVALUATOR_DEPLOYMENT_CAPACITY}"
    },
    "foundryEvaluatorDeploymentSkuName": {
      "value": "${FOUNDRY_EVALUATOR_DEPLOYMENT_SKU_NAME}"
    },
    "foundryEvaluatorDeploymentName": {
      "value": "${FOUNDRY_EVALUATOR_DEPLOYMENT_NAME}"
    },
    "foundryEvaluatorModelFormat": {
      "value": "${FOUNDRY_EVALUATOR_MODEL_FORMAT}"
    },
    "foundryEvaluatorModelName": {
      "value": "${FOUNDRY_EVALUATOR_MODEL_NAME}"
    },
    "foundryEvaluatorModelVersion": {
      "value": "${FOUNDRY_EVALUATOR_MODEL_VERSION}"
    },
    "foundryRaiPolicyName": {
      "value": "${FOUNDRY_RAI_POLICY_NAME}"
    }
  }
}
